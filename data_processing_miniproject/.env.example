# Salin menjadi .env bila ingin mengubah nilai bawaan. Script membaca variabel
# lewat environment (di PowerShell: $env:KAFKA_TOPIC = "orders").
# Tidak ada kredensial di project ini; Kafka lokal tanpa autentikasi.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=orders
KAFKA_GROUP_ID=orders-validation-group
